@using System.Security.Claims
@{
    ViewData["Title"] = "Agent Live Desk";
    Layout = "_AgentLayout";
    var currentAgentId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0";
    var currentAgentName = User.Identity?.Name ?? "Support Agent";
}

<!-- Top Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4 col-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Assigned Chats</div>
                <div id="statTotalAssigned" class="kpi-value">0</div>
            </div>
            <div class="kpi-icon blue"><i class="fa-solid fa-list-check"></i></div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Active Chats</div>
                <div id="statActiveChats" class="kpi-value text-success">0</div>
            </div>
            <div class="kpi-icon green"><i class="fa-solid fa-comments"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-4 col-6">
        <div class="kpi-card border-warning">
            <div>
                <div class="kpi-title">
                    Pending Queue <span class="pulse-indicator ms-1"></span>
                </div>
                <div id="statPendingChats" class="kpi-value text-warning">0</div>
            </div>
            <div class="kpi-icon amber"><i class="fa-solid fa-hourglass-half"></i></div>
        </div>
    </div>
    <div class="col-xl-2 col-md-6 col-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Completed</div>
                <div id="statCompletedChats" class="kpi-value text-secondary">0</div>
            </div>
            <div class="kpi-icon teal"><i class="fa-solid fa-circle-check"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Unread Messages</div>
                <div id="statUnreadMessages" class="kpi-value text-danger">0</div>
            </div>
            <div class="kpi-icon purple"><i class="fa-solid fa-envelope-open-text"></i></div>
        </div>
    </div>
</div>

<!-- 3-Column Real-Time Chat Workspace -->
<div class="agent-workspace">
    <!-- COLUMN 1: Conversations List & Queues -->
    <div class="chat-list-col">
        <div class="chat-list-tabs">
            <button class="chat-list-tab active" data-tab="active">
                <i class="fa-solid fa-comment-dots me-1 text-success"></i> Active
            </button>
            <button class="chat-list-tab" data-tab="pending">
                <i class="fa-solid fa-clock me-1 text-warning"></i> Pending
                <span id="pendingTabBadge" class="badge bg-warning text-dark rounded-pill ms-1" style="display:none; font-size:10px;">0</span>
            </button>
            <button class="chat-list-tab" data-tab="completed">
                <i class="fa-solid fa-box-archive me-1 text-secondary"></i> History
            </button>
        </div>

        <div class="chat-search-bar">
            <input type="text" id="chatSearchInput" class="chat-search-input" placeholder="Search by mobile or service..." />
        </div>

        <div id="chatItemsContainer" class="chat-items-scroll">
            <!-- Dynamically populated -->
        </div>
    </div>

    <!-- COLUMN 2: Selected Conversation Stream -->
    <div class="chat-conversation-col">
        <!-- Header -->
        <div class="chat-convo-header">
            <div class="chat-convo-user">
                <div class="chat-item-avatar" style="width:38px; height:38px;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <strong id="convoCustomerMobile" style="font-size:15px;">Select a conversation</strong>
                        <span id="convoStatusBadge" class="badge bg-secondary">Offline</span>
                    </div>
                    <div class="text-muted small">
                        <span id="convoServiceName" class="text-primary fw-semibold">Service</span> • 
                        <code id="convoSessionId" class="text-secondary">CHAT-ID</code>
                    </div>
                </div>
            </div>

            <div class="chat-convo-actions">
                <button id="btnTransferChat" type="button" class="btn btn-sm btn-outline-primary" title="Transfer Chat to another agent">
                    <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Transfer
                </button>
                <button id="btnCloseChat" type="button" class="btn btn-sm btn-outline-danger" title="End and complete chat">
                    <i class="fa-solid fa-circle-xmark me-1"></i> End Chat
                </button>
            </div>
        </div>

        <!-- Messages Stream -->
        <div id="agentConversationStream" class="chat-convo-messages">
            <div class="text-center p-5 text-muted">
                <i class="fa-regular fa-comment-dots fs-1 mb-2"></i>
                <p>Select an active or pending conversation from the left to start replying in real time.</p>
            </div>
        </div>

        <!-- Typing status in conversation -->
        <div id="agentTypingIndicator" class="px-3 py-1 text-muted small fst-italic" style="display:none; background:rgba(255,255,255,0.7);">
            <i class="fa-solid fa-pen-nib fa-beat-fade me-1 text-primary"></i> Customer is typing...
        </div>

        <!-- Composer / Input -->
        <div class="agent-composer">
            <input type="file" id="agentFileInput" style="display:none;" />
            <button id="btnAgentAttach" type="button" class="btn btn-light rounded-circle" title="Attach file or image">
                <i class="fa-solid fa-paperclip text-muted"></i>
            </button>
            <input type="text" id="agentMessageInput" class="agent-composer-input" placeholder="Type your reply to customer (Press Enter to send)..." autocomplete="off" disabled />
            <button id="btnAgentSend" type="button" class="btn btn-success rounded-circle" title="Send reply" style="width:42px; height:42px;" disabled>
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <!-- COLUMN 3: Customer Details & Internal Notes -->
    <div class="chat-info-col">
        <!-- Customer Info -->
        <div class="info-section">
            <div class="info-section-title">
                <i class="fa-solid fa-id-card me-1 text-primary"></i> Customer Information
            </div>
            <div class="info-item">
                <span class="info-label">Mobile Number</span>
                <span id="infoMobile" class="info-value">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Selected Service</span>
                <span id="infoService" class="info-value">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Session ID</span>
                <span id="infoSessionId" class="info-value" style="font-size:11px;">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Started At</span>
                <span id="infoStartTime" class="info-value" style="font-size:11px;">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Total Messages</span>
                <span id="infoTotalMessages" class="info-value">--</span>
            </div>
        </div>

        <!-- Internal Notes -->
        <div class="info-section flex-1 d-flex flex-column">
            <div class="info-section-title">
                <i class="fa-solid fa-note-sticky me-1 text-warning"></i> Internal Notes
            </div>
            <div id="internalNotesList" class="notes-list flex-1">
                <div class="text-muted small">Select a chat to view internal notes.</div>
            </div>
            <div class="mt-2">
                <textarea id="agentNoteInput" class="form-control form-control-sm mb-2" rows="2" placeholder="Write internal note (not visible to customer)..."></textarea>
                <button type="button" id="btnAddNote" class="btn btn-warning btn-sm w-100 fw-semibold">
                    <i class="fa-solid fa-plus me-1"></i> Add Note
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Transfer Chat -->
<div class="modal fade" id="transferChatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-arrow-right-arrow-left text-primary me-2"></i>Transfer Conversation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Select an active support agent to take over this conversation. The customer and agent will be notified immediately.</p>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Select Target Agent</label>
                    <select id="transferAgentSelect" class="form-select">
                        <option value="">-- Choose agent --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm fw-semibold" onclick="confirmTransferChat()">Confirm Transfer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/agent-chat.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.initAgentWorkspace(@currentAgentId, '@Html.Raw(currentAgentName)');
        });
    </script>
}
