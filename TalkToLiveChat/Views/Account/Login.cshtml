@model TalkToLiveChat.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Login";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white text-center py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-2" style="width:48px; height:48px;">
                        <i class="fa-solid fa-lock fs-5"></i>
                    </div>
                    <h4 class="fw-bold mb-1">TalkTo Support Portal</h4>
                    <p class="text-secondary small mb-0">Sign in to Agent Desk or Admin Dashboard</p>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div><i class="fa-solid fa-circle-exclamation me-1"></i> @err.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-muted text-uppercase">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input asp-for="Email" id="loginEmail" class="form-control" placeholder="name@tawkto.local" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-muted text-uppercase">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-key text-muted"></i></span>
                                <input asp-for="Password" id="loginPassword" type="password" class="form-control" placeholder="••••••••" required />
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold rounded-3 shadow-sm">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                        </button>
                    </form>

                    <div class="mt-4 pt-3 border-top">
                        <span class="small fw-bold text-muted d-block mb-2 text-uppercase">1-Click Quick Fill Credentials:</span>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger text-start py-1 px-2" onclick="fillCreds('admin@tawkto.local', 'Admin@123')">
                                <span class="badge bg-danger me-1">Admin</span> admin@tawkto.local
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary text-start py-1 px-2" onclick="fillCreds('rahul.tech@tawkto.local', 'Agent@123')">
                                <span class="badge bg-primary me-1">Agent</span> rahul.tech@tawkto.local (Tech)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success text-start py-1 px-2" onclick="fillCreds('priya.sales@tawkto.local', 'Agent@123')">
                                <span class="badge bg-success me-1">Agent</span> priya.sales@tawkto.local (Sales)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info text-start py-1 px-2" onclick="fillCreds('amit.support@tawkto.local', 'Agent@123')">
                                <span class="badge bg-info text-dark me-1">Agent</span> amit.support@tawkto.local (Support)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
