@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="text-danger mb-3">
                    <i class="fa-solid fa-triangle-exclamation fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-muted mb-4">You do not have the required role permissions to access this administrative portal.</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark me-2">Back to Home</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-success">Login with Another Account</a>
                </div>
            </div>
        </div>
    </div>
</div>
