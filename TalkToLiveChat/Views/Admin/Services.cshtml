@model List<TalkToLiveChat.Models.Entities.ServiceItem>
@{
    ViewData["Title"] = "Chat Service Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Live Chat Services Catalog</h4>
        <p class="text-muted small mb-0">Configure the customer-facing services dropdown, display ordering, descriptions, and activation status.</p>
    </div>
    <button type="button" class="btn btn-success fw-semibold rounded-3 shadow-sm" onclick="openServiceModal(0, '', '', 10, true)">
        <i class="fa-solid fa-plus me-1"></i> Add New Service
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th style="width:70px;">Order</th>
                    <th>Service Name</th>
                    <th>Description</th>
                    <th>Assigned Agents</th>
                    <th>Total Sessions</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border fw-bold">#@s.DisplayOrder</span></td>
                        <td>
                            <strong class="text-dark">@s.ServiceName</strong>
                        </td>
                        <td class="text-muted small" style="max-width:320px;">
                            @(string.IsNullOrEmpty(s.Description) ? "--" : s.Description)
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary">
                                <i class="fa-solid fa-headset me-1"></i> @s.AssignedAgentsCount Agents
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary">
                                @s.TotalSessionsCount Chats
                            </span>
                        </td>
                        <td>
                            <span class="badge @(s.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" 
                                        onclick="openServiceModal(@s.ServiceId, '@Html.Raw(s.ServiceName)', '@Html.Raw(s.Description ?? "")', @s.DisplayOrder, @(s.IsActive ? "true" : "false"))" title="Edit Service">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success") py-0 px-2" 
                                        onclick="toggleServiceStatus(@s.ServiceId, @(s.IsActive ? "false" : "true"))" title="@(s.IsActive ? "Deactivate" : "Activate")">
                                    <i class="fa-solid @(s.IsActive ? "fa-ban" : "fa-check")"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add / Edit Service -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="serviceModalTitle">
                    <i class="fa-solid fa-cubes-stacked text-success me-2"></i>Configure Service
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="serviceForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="serviceId" name="ServiceId" value="0" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Service Name</label>
                        <input type="text" id="serviceName" name="ServiceName" class="form-control" placeholder="e.g. Technical Support" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description / Customer Guidance</label>
                        <textarea id="serviceDescription" name="Description" class="form-control" rows="2" placeholder="Brief explanation shown to customers..."></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Display Order</label>
                            <input type="number" id="serviceDisplayOrder" name="DisplayOrder" class="form-control" value="1" min="1" max="999" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Service Status</label>
                            <select id="serviceIsActive" name="IsActive" class="form-select">
                                <option value="true">Active (Visible)</option>
                                <option value="false">Inactive (Hidden)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-semibold">Save Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openServiceModal(id, name, desc, order, isActive) {
            document.getElementById('serviceId').value = id;
            document.getElementById('serviceName').value = name;
            document.getElementById('serviceDescription').value = desc;
            document.getElementById('serviceDisplayOrder').value = order;
            document.getElementById('serviceIsActive').value = isActive ? 'true' : 'false';

            if (id === 0) {
                document.getElementById('serviceModalTitle').innerHTML = '<i class="fa-solid fa-plus text-success me-2"></i>Add New Service';
            } else {
                document.getElementById('serviceModalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Service';
            }

            const modal = new bootstrap.Modal(document.getElementById('serviceModal'));
            modal.show();
        }

        document.getElementById('serviceForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const res = await fetch('/Admin/SaveService', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Error saving service.');
                }
            } catch (err) {
                alert('Error saving service.');
            }
        });

        async function toggleServiceStatus(serviceId, isActive) {
            const action = isActive ? 'activate' : 'deactivate';
            if (!confirm(`Are you sure you want to ${action} this service?`)) return;

            try {
                await fetch(`/Admin/ToggleServiceStatus?serviceId=${serviceId}&isActive=${isActive}`, { method: 'POST' });
                location.reload();
            } catch (e) {
                alert('Error updating service status.');
            }
        }
    </script>
}
