@{
    ViewData["Title"] = "Customer Live Chat";
}

<div class="hero-section py-5 bg-light border-bottom">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
                    <i class="fa-solid fa-headset me-1"></i> Tawk.to-Style Real-Time Live Chat
                </div>
                <h1 class="display-4 fw-extrabold text-dark tracking-tight mb-3">
                    Instant Customer Support with <span class="text-success">Live Two-Way Chat</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    Experience a responsive, multi-channel live chat application. Connect with dedicated technical specialists, website architects, and sales advisors in real time.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="btn btn-success btn-lg px-4 py-3 fw-bold rounded-3 shadow-sm" onclick="document.getElementById('talktoLauncherBtn').click();">
                        <i class="fa-solid fa-comment-dots me-2"></i> Click to Open Live Chat Widget
                    </button>
                    <a asp-controller="Agent" asp-action="Index" class="btn btn-outline-dark btn-lg px-4 py-3 fw-semibold rounded-3">
                        <i class="fa-solid fa-user-headset me-2"></i> Open Agent Workspace
                    </a>
                </div>
                <div class="mt-4 pt-2 d-flex align-items-center gap-4 text-muted small">
                    <div><i class="fa-solid fa-shield-check text-success me-1"></i> No OTP or Password Required</div>
                    <div><i class="fa-solid fa-bolt text-warning me-1"></i> SignalR Powered</div>
                    <div><i class="fa-solid fa-database text-primary me-1"></i> SQL Server ADO.NET</div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                        <span class="small fw-semibold"><i class="fa-solid fa-shield-halved text-success me-1"></i> Live Chat Simulation Guide</span>
                        <span class="badge bg-success">Step-by-Step</span>
                    </div>
                    <div class="card-body p-4 bg-white">
                        <div class="d-flex gap-3 mb-3">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width:32px; height:32px; flex-shrink:0;">1</div>
                            <div>
                                <h6 class="fw-bold mb-1">Click the Floating Chat Icon</h6>
                                <p class="text-muted small mb-0">Look at the bottom-right corner and click the green chat bubble.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:32px; height:32px; flex-shrink:0;">2</div>
                            <div>
                                <h6 class="fw-bold mb-1">Enter 10-Digit Mobile Number</h6>
                                <p class="text-muted small mb-0">Provide an Indian 10-digit mobile number (e.g. <code>9876543210</code>). No OTP needed.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width:32px; height:32px; flex-shrink:0;">3</div>
                            <div>
                                <h6 class="fw-bold mb-1">Select Service from Database</h6>
                                <p class="text-muted small mb-0">Choose from 9 dynamically fetched services configured by the Admin.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center fw-bold" style="width:32px; height:32px; flex-shrink:0;">4</div>
                            <div>
                                <h6 class="fw-bold mb-1">Real-Time Messaging with Agent</h6>
                                <p class="text-muted small mb-0">Auto-assigned to an online specialist, two-way messaging, typing alerts, attachments, and history.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Services Grid Section -->
<section id="services-section" class="py-5">
    <div class="container py-4">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <span class="text-success text-uppercase fw-bold small tracking-wider">Dynamic SQL Catalog</span>
            <h2 class="fw-bold text-dark mt-1">Our Supported Services</h2>
            <p class="text-muted">Managed and configured in real time through the SQL Server database and Admin Panel.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-screwdriver-wrench fs-4"></i>
                    </div>
                    <h5 class="fw-bold">1. Technical Support</h5>
                    <p class="text-muted small">Assistance with software troubleshooting, technical glitches, bug investigations, and infrastructure debugging.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-code fs-4"></i>
                    </div>
                    <h5 class="fw-bold">2. Website Development</h5>
                    <p class="text-muted small">Custom full-stack web applications, modern responsive UI designs, performance tuning, and CMS architectures.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-info-subtle text-info p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-laptop-code fs-4"></i>
                    </div>
                    <h5 class="fw-bold">3. Software Development</h5>
                    <p class="text-muted small">Robust enterprise architectures, microservices, cloud deployments, REST and gRPC API engineering.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-warning-subtle text-warning p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-credit-card fs-4"></i>
                    </div>
                    <h5 class="fw-bold">4. Payment Related Query</h5>
                    <p class="text-muted small">Billing enquiries, GST invoices, online gateway support, subscriptions, refunds, and transaction tracking.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-danger-subtle text-danger p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-box-open fs-4"></i>
                    </div>
                    <h5 class="fw-bold">5. Product Enquiry</h5>
                    <p class="text-muted small">Deep dive into feature breakdowns, solution architectures, licensing models, and system integrations.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-secondary-subtle text-secondary p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-bullhorn fs-4"></i>
                    </div>
                    <h5 class="fw-bold">6. Sales & Marketing</h5>
                    <p class="text-muted small">Commercial proposals, bespoke enterprise plans, partnership opportunities, and vendor onboarding.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-user-gear fs-4"></i>
                    </div>
                    <h5 class="fw-bold">7. Account Related Query</h5>
                    <p class="text-muted small">User credentials, access permission levels, security verifications, profile preferences, and account maintenance.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-circle-question fs-4"></i>
                    </div>
                    <h5 class="fw-bold">8. General Enquiry</h5>
                    <p class="text-muted small">General questions regarding operational hours, physical locations, SLA guidelines, and company guidelines.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="rounded-3 bg-dark-subtle text-dark p-3 d-inline-block mb-3" style="width:fit-content;">
                        <i class="fa-solid fa-comments fs-4"></i>
                    </div>
                    <h5 class="fw-bold">9. Other</h5>
                    <p class="text-muted small">Any unique inquiries, bespoke collaboration requests, or direct feedback submitted to our team.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features-section" class="py-5 bg-white border-top">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-success text-uppercase fw-bold small tracking-wider">Complete Feature Set</span>
                <h2 class="fw-bold text-dark mt-1 mb-4">Enterprise Grade Customer Engagement</h2>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Mobile Number Validation Without OTP</h6>
                            <p class="text-muted small">Immediate client-side and server-side validation for 10-digit Indian numbers (+91 default) with direct database persistence.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Real-Time Messaging with SignalR</h6>
                            <p class="text-muted small">Two-way real-time conversation, double-tick read indicators, live typing indicators, and file/image uploads.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Automatic Load-Balanced Agent Routing</h6>
                            <p class="text-muted small">Incoming requests are intelligently matched to online specialists based on service capability and concurrent chat capacity.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Session Restoration & Auto-Reconnect</h6>
                            <p class="text-muted small">Browser refreshes or temporary network disruptions automatically restore the live chat session seamlessly.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 bg-light rounded-4 border">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-users me-2 text-primary"></i>Test Accounts Credentials</h5>
                    <p class="text-muted small mb-3">Use these pre-configured credentials to log into the Agent or Admin portals:</p>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm bg-white small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Role</th>
                                    <th>Email</th>
                                    <th>Password</th>
                                    <th>Assigned Services</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-danger">Admin</span></td>
                                    <td><code>admin@tawkto.local</code></td>
                                    <td><code>Admin@123</code></td>
                                    <td>All 9 Services</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary">Agent (Rahul)</span></td>
                                    <td><code>rahul.tech@tawkto.local</code></td>
                                    <td><code>Agent@123</code></td>
                                    <td>Tech, Website, Software</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success">Agent (Priya)</span></td>
                                    <td><code>priya.sales@tawkto.local</code></td>
                                    <td><code>Agent@123</code></td>
                                    <td>Payment, Product, Sales</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-info">Agent (Amit)</span></td>
                                    <td><code>amit.support@tawkto.local</code></td>
                                    <td><code>Agent@123</code></td>
                                    <td>Account, General, Other</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 text-end">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm fw-semibold">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Go to Login Page
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
